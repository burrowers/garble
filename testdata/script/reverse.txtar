# Unknown build flags should result in errors.
! exec garble reverse -badflag=foo .
stderr 'flag provided but not defined'
# Reverse never links, so it must not patch and build the linker in the
# background; such a build would outlive garble and litter the temporary dir.
# Note that we rely on the unix-like TMPDIR env var name.
[!windows] ! grepfiles ${TMPDIR} 'go-build'

exec garble build
exec ./main
cp stderr main.stderr

# Ensure that the garbled panic output looks correct.
# This output is not reproducible between 'go test' runs,
# so we can't use a static golden file.
grep 'goroutine 1 \[running\]' main.stderr
# Note that ExportedLibMethod isn't obfuscated.
# Note that we use long names like "long_lib.go",
# because an obfuscated filename could realistically end with "lib".
! grep 'ExportedLib(Type|Field)|unexportedMainFunc|test/main|long_main\.go|long_lib\.go' main.stderr

stdin main.stderr
exec garble reverse .
cmp stdout reverse.stdout

# Ensure that we cleaned up the temporary files.
# Note that we rely on the unix-like TMPDIR env var name.
[!windows] ! grepfiles ${TMPDIR} 'garble|importcfg|cache\.gob|\.go'

# Test-only sources are compiled into test variants, not the ordinary package.
# Compare frame output without verbose per-test elapsed times.
go test -c -trimpath -o plain-test$exe .
exec ./plain-test$exe -test.run=TestReverse
cp stdout test.expected
exec garble test -c -o obfuscated-test$exe .
exec ./obfuscated-test$exe -test.run=TestReverse
stdin stdout
exec garble reverse -test .
cmp stdout test.expected

[short] stop # no need to verify this with -short

# Ensure that the reversed output matches the non-garbled output.
go build -trimpath
exec ./main
cmp stderr reverse.stdout

# The go statement owns the position of a goroutine's creation site, which a
# panic trace prints as "created by". Reverse it to the same line as plain Go.
go build -trimpath -o goroutine-plain$exe ./case/goroutine
! exec ./goroutine-plain$exe
stderr 'goroutine_site\.go:10\b'
exec garble build -o goroutine-obfuscated$exe ./case/goroutine
! exec ./goroutine-obfuscated$exe
cp stderr goroutine-obfuscated.stderr
stdin goroutine-obfuscated.stderr
exec garble reverse ./case/goroutine
stdout 'goroutine_site\.go:10\b'
stdout 'goroutine_site\.go:5\b'

# A panic raised by the runtime at a statement without a call expression would
# otherwise inherit the position of the last call marker in the file. Reverse it
# to the panicking statement's own line.
go build -trimpath -o statement-plain$exe ./case/statement
! exec ./statement-plain$exe
stderr 'statement_site\.go:10\b'
exec garble build -o statement-obfuscated$exe ./case/statement
! exec ./statement-obfuscated$exe
cp stderr statement-obfuscated.stderr
stdin statement-obfuscated.stderr
exec garble reverse ./case/statement
stdout 'statement_site\.go:10\b'
! stdout 'statement_site\.go:9\b'

# Ensure that we can still reverse with -literals.
exec garble -literals build
exec ./main
cp stderr main-literals.stderr

stdin main-literals.stderr
exec garble -literals reverse .
cmp stdout reverse.stdout

# Reversing a -literals output without the flag should fail.
stdin main-literals.stderr
! exec garble reverse .
cmp stdout main-literals.stderr

# A source //line directive supplies a logical filename and line, not just a line.
go build -trimpath -o line-plain$exe ./case/line
exec ./line-plain$exe
cp stdout line.expected
exec garble -literals build -o line-obfuscated$exe ./case/line
exec ./line-obfuscated$exe
stdin stdout
exec garble -literals reverse ./case/line
cmp stdout line.expected

# https://github.com/burrowers/garble/pull/967
# Ensure that we can reverse a package with build tag required.
exec garble build -o tag.bin -tags sometag ./case/tag
exec ./tag.bin
cp stderr tag.stderr
! grep "main.CallerFuncName" tag.stderr
stdin tag.stderr
exec garble reverse -tags sometag ./case/tag
stdout main\.CallerFuncName

-- go.mod --
module test/main

go 1.23
-- reverse_test.go --
package main

import (
	"fmt"
	"runtime"
	"testing"
)

func TestReverseTestFile(t *testing.T) {
	_, file, line, ok := runtime.Caller(0)
	fmt.Printf("test frame: %s:%d:%t\n", file, line, ok)
}
