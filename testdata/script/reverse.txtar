-- long_main.go --
package main

import (
	"log"
	"os"
	"runtime"

	"test/main/lib"
)

func main() {
	unexportedMainFunc()

	// A decoded literal inside a chained call must not leave a position
	// that garble reverse cannot recognize (issue #762).
	log.SetFlags(log.Llongfile)
	(&Logger{}).Fields("marker", "[request]").Info("first")

	_, filename, _, _ := runtime.Caller(0)
	println()
	println("main filename:", filename)
	callSites()
}

type Logger struct{}

func (l *Logger) Fields(args ...any) *Logger { return l }
func (l *Logger) Info(message string)        { _ = log.Output(2, message) }

func unexportedMainFunc() {
	anonFunc := func() {
		lt := lib.ExportedLibType{}
		if err := lt.ExportedLibMethod(os.Stderr); err != nil {
			panic(err)
		}
	}
	anonFunc()
}

-- lib/long_lib.go --
package lib

import (
	"bytes"
	"io"
	"regexp"
	"runtime"
	"runtime/debug"
)

type ExportedLibType struct {
	ExportedLibField int
}

func (*ExportedLibType) ExportedLibMethod(w io.Writer) error {
	_, filename, _, _ := runtime.Caller(0)
	println("lib filename:", filename)
	println()

	return printStackTrace(w)
}

func printStackTrace(w io.Writer) error {
	// Panic outputs include "0xNN" pointers and offsets which change
	// between platforms.
	// The format also changes depending on the ABI.
	// Strip them out here, to have portable static stdout files.
	rxCallArgs := regexp.MustCompile(`\(({|0x)[^)]+\)|\(\)`)
	rxPointer := regexp.MustCompile(`\+0x[[:xdigit:]]+`)

	// Keep this comment here, because comments affect line numbers.

	stack := debug.Stack()
	stack = rxCallArgs.ReplaceAll(stack, []byte("(...)"))
	stack = rxPointer.ReplaceAll(stack, []byte("+0x??"))

	// Drop the second and third lines, as they show a position in runtime/debug
	// which can change between Go versions.
	stackLines := bytes.Split(stack, []byte("\n"))
	stackLines = append(stackLines[:1], stackLines[3:]...)
	_, err := w.Write(bytes.Join(stackLines, []byte("\n")))
	return err
}

-- case/line/main.go --
package main

import (
	"fmt"
	"runtime"
)

func main() {
//line virtual/rewritten.go:317
	_, file, line, _ := runtime.Caller(0)
	fmt.Printf("logical=%s:%d\n", file, line)
	fmt.Printf("logical-file=%s\n", file)
	fmt.Println("distinct-literal-message-in-logical-frame")
//line /virtual/absolute.go:410
	_, file, line, _ = runtime.Caller(0)
	fmt.Printf("absolute=%s:%d\n", file, line)
	fmt.Printf("absolute-file=%s\n", file)
}

-- case/tag/main.go --
//go:build sometag

package main

import "runtime"

func main() {
	println(CallerFuncName())
}

func CallerFuncName() string {
	pc, _, _, _ := runtime.Caller(0)
	fn := runtime.FuncForPC(pc)
	return fn.Name()
}

-- case/statement/statement_site.go --
package main

var buf [1]byte

var idx = 7

//go:noinline
func boom() {
	println("before")
	_ = buf[idx]
}

func main() {
	boom()
}

-- case/goroutine/goroutine_site.go --
package main

//go:noinline
func panicSite() {
	panic("case-goroutine-panic")
}

//go:noinline
func spawn() {
	go panicSite()
}

func main() {
	block := make(chan struct{})
	spawn()
	<-block
}

-- call_sites.go --
package main

import (
	"runtime"
	"strconv"
)

//go:noinline
func callSites() {
	// Each call's parenthesis must have its own position marker.
	func() {
		reportCallers("iife")
	}()
	s := site{}
	s.
		report()
	s.
		chain().
		report()
}

type site struct{}

func (s site) chain() site { return s }

func (site) report() { reportCallers("multiline") }

func reportCallers(label string) {
	for skip := 1; skip <= 2; skip++ {
		_, file, line, _ := runtime.Caller(skip)
		println(label, file+":"+strconv.Itoa(line))
	}
}

