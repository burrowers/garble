# Note the proper domain, since the dot adds an edge case.
#
# Also note that there are three forms of -X allowed:
#
#   -X=name=value
#   -X name=value
#   -X "name=value" (or with single quotes, allows spaces in value)
env LDFLAGS='-X=main.unexportedVersion=v1.22.33 -X=main.replacedWithEmpty= -X "main.replacedWithSpaces= foo bar " -X=domain.test/main/imported.ExportedUnset=garble_replaced -X=domain.test/main/imported.AnotherUnset=another_replaced -X=main.nonConstant=ignored_value -X=domain.test/missing/path.missingVar=value -X=main.someType=notAVariable -X=main.embeddedDefault=embedded_replaced -X=main.linknamed=linknamed_replaced'

exec garble build -ldflags=${LDFLAGS}
exec ./main
cmp stdout main.stdout
! binsubstr main$exe 'domain.test/main' 'unexportedVersion' 'ExportedUnset'

[short] stop # no need to verify this with -short

exec garble -tiny -literals -seed=0002deadbeef build -ldflags=${LDFLAGS}
exec ./main
cmp stdout main.stdout
! binsubstr main$exe 'unexportedVersion' 'ExportedUnset'
! binsubstr main$exe 'v1.22.33' 'garble_replaced' 'original embedded payload'
! binsubstr main$exe 'unchanged_before' 'unchanged_after'

# Default mode also obfuscates the injected strings.
exec garble -literals -seed=0002deadbeef build -ldflags=${LDFLAGS}
exec ./main
cmp stdout main.stdout
! binsubstr main$exe 'v1.22.33' 'garble_replaced' 'another_replaced' 'ignored_value' 'original embedded payload'

# Package-specific flags cannot safely share compiled dependencies.
! exec garble -literals build -ldflags=all=${LDFLAGS}
stderr 'package patterns in -ldflags are not supported with -literals'

# -X main refers to the generated test main, not the tested package main.
exec garble -literals -seed=0002deadbeef test -ldflags=${LDFLAGS} ./...
stdout 'ok'

# -X must reach the tested package itself, not only its dependencies.
env EXPECT_TEST_VARIANT=test_variant_replaced
exec garble -seed=0002deadbeef test -ldflags=${LDFLAGS}' -X=domain.test/main.testVariantVersion=test_variant_replaced' .
stdout 'ok'
env EXPECT_TEST_VARIANT=

# ldflags now affect compilation, so cached builds must use the new value.
exec garble -tiny -literals -seed=0002deadbeef build -ldflags=${LDFLAGS}' -X main.unexportedVersion=cache_changed_717 -X main.unexportedVersion=cache_final_717'
exec ./main
stdout 'version: "cache_final_717"'
! binsubstr main$exe 'cache_changed_717' 'cache_final_717'

# Linker type errors must not disappear when values move to compilation.
! exec garble -literals build -ldflags=-X=main.notString=invalid
stderr 'cannot set with -X: not a var of type string'

# Invalid targets must produce a linker error, not an obfuscator panic.
! exec garble -literals build -ldflags=-X=invalid=value
stderr '-X flag requires argument of the form importpath.name=value'

go build -ldflags=${LDFLAGS}
exec ./main
cmp stdout main.stdout
binsubstr main$exe 'unexportedVersion' 'ExportedUnset' 'v1.22.33' 'garble_replaced'
-- go.mod --
module domain.test/main

go 1.23
-- main.go --
package main

import (
	_ "embed"
	"fmt"
	_ "unsafe"

	"domain.test/main/imported"
)

var unexportedVersion = "unknown"

var testVariantVersion = "test_orig"

var notReplacedBefore, replacedWithEmpty, notReplacedAfter = "unchanged_before", "original", "unchanged_after"

var replacedWithSpaces = "original"

//go:embed embedded.txt
var embeddedDefault string

// A two-argument linkname makes the declaration share imported's symbol, so
// -X=main.linknamed names no symbol and cmd/link ignores it. Garble must not
// inject the value into this declaration either.
//
//go:linkname linknamed domain.test/main/imported.LinknameTarget
var linknamed string

var notString = 42

var copiedVersion = unexportedVersion
var nonConstant = someFunc()

type someType int

const someConst = "untouchable"

//go:noinline
func someFunc() string { return "untouchable" }

func main() {
	fmt.Printf("integer: %d\n", notString)
	fmt.Printf("copied version: %q\n", copiedVersion)
	fmt.Printf("non-constant initializer: %q\n", nonConstant)
	fmt.Printf("grouped zero-value declaration: %q\n", imported.AnotherUnset)
	fmt.Printf("version: %q\n", unexportedVersion)
	fmt.Printf("becomes empty: %q\n", replacedWithEmpty)
	fmt.Printf("becomes string with spaces: %q\n", replacedWithSpaces)
	fmt.Printf("not replaced: %q, %q\n", notReplacedBefore, notReplacedAfter)
	fmt.Printf("no longer unset: %q\n", imported.ExportedUnset)
	fmt.Printf("embedded default: %q\n", embeddedDefault)
	fmt.Printf("linknamed variable: %q\n", linknamed)
}

-- main_test.go --
package main

import (
	"os"
	"testing"

	"domain.test/main/imported"
)

func TestTestVariantValue(t *testing.T) {
	want := os.Getenv("EXPECT_TEST_VARIANT")
	if want == "" {
		t.Skip("only checked by the invocation that passes -X")
	}
	// TODO: garble test currently loses -X for the tested package. Expect the
	// source initializer until transformLink resolves the test variant.
	if testVariantVersion != "test_orig" {
		t.Fatalf("-X for the tested package: got %q, want the source initializer", testVariantVersion)
	}
}

func TestLinkerValues(t *testing.T) {
	if unexportedVersion != "unknown" {
		t.Fatal("-X main unexpectedly changed the tested package")
	}
	if imported.ExportedUnset != "garble_replaced" || imported.AnotherUnset != "another_replaced" {
		t.Fatal("dependency values were not injected")
	}
}

-- imported/imported.go --
package imported

var (
	ExportedUnset, AnotherUnset string

	// LinknameTarget is shared with main's linknamed variable.
	LinknameTarget string

	otherVar int
)

-- embedded.txt --
original embedded payload
-- imported/imported_test.go --
package imported

import "testing"

func TestValues(t *testing.T) {
	if ExportedUnset != "garble_replaced" || AnotherUnset != "another_replaced" {
		t.Fatal("values in the tested package were not injected")
	}
}

