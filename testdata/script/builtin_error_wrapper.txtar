# The runtime must emit the builtin error.Error wrapper even when its package
# path is obfuscated. Taking the method expression requires that wrapper.
env GARBLE_EXPERIMENTAL_CONTROLFLOW=0
exec garble -seed=tkeruNBZVdMHbct5bi6dDQ build -o=main$exe .
exec ./main$exe
stderr '^builtin-error-wrapper-ok$'

-- go.mod --
module test/builtinerrorwrapper

go 1.27
-- main.go --
package main

import "errors"

var errorText = error.Error

func main() {
	println(errorText(errors.New("builtin-error-wrapper-ok")))
}
