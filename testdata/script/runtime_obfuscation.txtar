# Runtime obfuscation requires rebuilding a large part of the standard library.
[short] skip 'runtime obfuscation is an integration test'

# Exercise goroutines, channels, maps, allocation, formatting, and runtime APIs.
env GOGARBLE='*'
exec garble -seed=AAAAAAAAAAA build -o=main$exe .
exec ./main$exe
stdout '^runtime-obfuscation-ok:'

# This ordinary Go implementation detail should be renamed. It is neither a
# compiler intrinsic nor an assembly or linker ABI dependency.
! binsubstr main$exe 'internal/runtime/maps.(*Map).getWithKey'

-- go.mod --
module test/runtimeobfuscation

go 1.27
-- main.go --
package main

import (
	"fmt"
	"runtime"
	"sync"
)

func main() {
	var wg sync.WaitGroup
	results := make(chan string, 1)
	wg.Add(1)
	go func() {
		defer wg.Done()
		values := map[string]int{"answer": 42}
		results <- fmt.Sprintf("runtime-obfuscation-ok:%s:%d:%d", runtime.GOOS, values["answer"], runtime.NumCPU())
	}()
	wg.Wait()
	fmt.Println(<-results)
}
