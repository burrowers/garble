env GOMODCACHE=$WORK/modcache
env GODEBUG=gocachehash=1
exec garble build -tags buildtag -v -x -debug-actiongraph=first.json
cp stderr first.log
cp main$exe old$exe
rm main$exe
exec garble build -tags buildtag -v -x -debug-actiongraph=second.json
cp stderr second.log
bincmp main$exe old$exe
