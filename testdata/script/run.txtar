exec garble run garble_main.go
! stdout '^garble_main\.go 9$'
stdout '\.go \d'

# TODO: program arguments should reach the executable, not go list.
! exec garble run garble_main.go hello
stderr 'named files must be .go files: hello'
! exec garble run . hello
stderr 'package hello is not in std'

[short] stop # no need to verify this with -short

# also with a package
exec garble run .
! stdout '^garble_main\.go 9$'
stdout '\.go \d'

go run garble_main.go
stdout 'garble_main\.go 10$'
-- go.mod --
module test/main

go 1.23
-- garble_main.go --
package main

import (
	"fmt"
	"os"
	"runtime"
)

func main() {
	_, file, line, _ := runtime.Caller(0)
	fmt.Println(file, line)
	fmt.Printf("args=%q\n", os.Args[1:])
}
