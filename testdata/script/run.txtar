exec garble run garble_main.go
! stdout '^garble_main\.go 9$'
stdout '\.go \d'

# Program arguments belong to the executable, not the package listing.
exec garble run garble_main.go hello
stdout 'args=\["hello"\]'
exec garble run . hello
stdout 'args=\["hello"\]'
exec garble run garble_main.go -value
stdout 'args=\["-value"\]'
exec garble run garble_main.go extra.go hello
stdout 'args=\["hello"\]'

[short] stop # no need to verify this with -short

# also with a package
exec garble run .
! stdout '^garble_main\.go 9$'
stdout '\.go \d'

go run garble_main.go
stdout 'garble_main\.go 10$'
-- extra.go --
package main

var _ = "multi-file input"
-- go.mod --
module test/main

go 1.23
-- garble_main.go --
package main

import (
	"fmt"
	"os"
	"runtime"
)

func main() {
	_, file, line, _ := runtime.Caller(0)
	fmt.Println(file, line)
	fmt.Printf("args=%q\n", os.Args[1:])
}
