import "test/main/lib3"

type MethodInterface interface{ CrossPackageMethod() string }

type Struct2 struct {
	Foo int
	Bar []*struct {
		Nested       *[]string
		NestedTagged string `json:"tagged2"`
		NestedAlias  alias2
	}
	Named lib3.Named
	lib3.StructEmbed
	Tagged string `json:"tagged2"`
	Alias  alias2
}

type alias2 = int64
