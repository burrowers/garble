# Calling a method obtained via reflect.Value.Method keeps that method reachable
# through the linker's deadcode pass. The compiler recognizes the reflect.Value
# Method result by name, so this exercises the obfuscated runtime end to end.
[short] skip 'runtime obfuscation is an integration test'

exec garble build -o=main$exe .
exec ./main$exe
cmp stdout main.stdout

-- go.mod --
module test/reflectmethodcall

go 1.27
-- main.go --
package main

import (
	"fmt"
	"reflect"
)

type T struct{}

func (T) M() string { return "M called" }

func main() {
	var v any = T{}
	fmt.Println(reflect.ValueOf(v).Method(0).Call(nil)[0])
}
-- main.stdout --
M called
