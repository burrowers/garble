exec garble build
exec ./main
cmp stderr main.stderr

# TODO: why is 'obfuscatedMethod' present?
! binsubstr main$exe 'obfuscatedFunc' 'ObfuscatedFunc'
! binsubstr main$exe 'ObfuscatedMethod'

[short] stop # no need to verify this with -short

# Both runtime modes must execute the real integrity check and self-tests.
env GODEBUG=fips140=on
exec ./main
cmp stderr main.stderr
env GODEBUG=fips140=only
exec ./main
cmp stderr main.stderr
[linux] exec fipscorrupt main$exe tampered$exe
[linux] ! exec ./tampered$exe
[linux] stderr 'fips140: verification mismatch'
env GODEBUG=fips140=on,failfipscast=SHA2-256
! exec ./main
stderr 'FIPS 140-3 self-test failed: SHA2-256'
env GODEBUG=

# PIE exercises the FIPS no-absolute-relocation contract with literal decoders.
exec garble -literals build -buildmode=pie
env GODEBUG=fips140=only
exec ./main
cmp stderr main.stderr
env GODEBUG=

# Frozen FIPS packages have versioned import paths, but keep unversioned
# runtime linknames. The versioned package must retain the runtime ABI.
env GOFIPS140=v1.0.0
exec garble build
env GODEBUG=fips140=only
exec ./main
cmp stderr main.stderr
env GOFIPS140=off
env GODEBUG=

go build
exec ./main
cmp stderr main.stderr
