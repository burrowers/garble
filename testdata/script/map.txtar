# 'garble map' without packages prints usage and fails.
! exec garble map
stderr 'usage: garble \[garble flags\] map'

# Unknown build flags should result in errors, like 'garble reverse'.
! exec garble map -badflag=foo .
stderr 'flag provided but not defined'

env SEED=OQg9kACEECQ

# A fixed seed makes the obfuscated names deterministic. Compare the complete
# module entries, without depending on which standard packages also appear.
exec garble -seed=${SEED} map ./...
cp stdout map.json
exec go run checkmap.go map.json
cmp stdout expected.json

# The imported package's path is obfuscated, while the main package keeps
# 'main'. Exported interface methods and unreachable names have no entries.
# The exact objects map also checks that the unexported method is Type.M1.

-- checkmap.go --
//go:build ignore

package main

import (
	"encoding/json"
	"fmt"
	"os"
)

func main() {
	data, err := os.ReadFile(os.Args[1])
	if err != nil {
		panic(err)
	}
	var all map[string]json.RawMessage
	if err := json.Unmarshal(data, &all); err != nil {
		panic(err)
	}
	selected := make(map[string]any)
	for _, path := range []string{"test/main", "test/main/lib"} {
		entry, ok := all[path]
		if !ok {
			panic(fmt.Sprintf("missing %s", path))
		}
		var value any
		if err := json.Unmarshal(entry, &value); err != nil {
			panic(err)
		}
		selected[path] = value
	}
	out, err := json.MarshalIndent(selected, "", "  ")
	if err != nil {
		panic(err)
	}
	fmt.Println(string(out))
}
-- expected.json --
{
  "test/main": {
    "objects": {},
    "path": "main"
  },
  "test/main/lib": {
    "objects": {
      "Func": "WyCltOQD7",
      "Type": "DhGKDlt9JmL",
      "Type.M1": "gjmYsc0O8lJ",
      "Type.UF0": "C8xgTKGxp",
      "Type.UF1": "bY3gZ_F_i",
      "hidden": "b5SrWf",
      "hidden.UF0": "NjPGe8"
    },
    "path": "oe8YBK"
  }
}
-- go.mod --
module test/main

go 1.23
-- main.go --
package main

import "test/main/lib"

func main() {
	t := lib.Type{Exported: 1}
	t.Method()
	lib.Func()
}
-- lib/lib.go --
package lib

// Type is an exported type with a mix of exported and unexported members.
type Type struct {
	Exported   int
	unexported int
}

func (Type) Method()           {}
func (Type) unexportedMethod() {}

// Func is an exported function.
func Func() {}

func unexportedFunc() {}

// hidden is an unexported type, still referenceable via objectpath.
type hidden struct{ Field int }
