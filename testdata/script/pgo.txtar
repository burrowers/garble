# The default PGO profile must not make Go's package variants invisible to toolexec.
# Keep the profile small, but import two packages that were missing from the
# shared listing when linknamed standard packages were folded into `go list`.
go test -p=2 -run=^$ -bench=. -benchtime=20x -cpuprofile=default.pgo .
rm pgo.test$exe
env GOGARBLE=example.com/pgo
# TODO(#1084): this build currently fails because go list decorates PGO dependencies.
! exec garble build -p=2 -o=app$exe .
stderr 'TOOLEXEC_IMPORTPATH package not found in listed packages: (crypto/md5|net/url)'

-- go.mod --
module example.com/pgo

go 1.27
-- main.go --
package main

import (
    "crypto/md5"
    "fmt"
    "net/url"
)

func main() {
    u, _ := url.Parse("https://example.com/abc")
    fmt.Printf("%x\n", md5.Sum([]byte(u.Path[1:])))
}
-- prof_test.go --
package main

import "testing"

func BenchmarkWork(b *testing.B) {
    for i := 0; i < b.N; i++ {
        _ = i * i
    }
}
