# A recover() inside a deferred func created by reflect.MakeFunc catches the
# panic. The compiler only sets the WRAPPER flag that enables this by comparing
# the obfuscated runtime.reflectcall and reflect.callReflect names, so this
# exercises the obfuscated runtime end to end.
[short] skip 'runtime obfuscation is an integration test'

exec garble build -o=main$exe .
exec ./main$exe
cmp stdout main.stdout

-- go.mod --
module test/reflectrecover

go 1.27
-- main.go --
package main

import (
	"fmt"
	"reflect"
)

func report(name string, r any) {
	if r == nil {
		fmt.Println("FAIL", name)
	} else {
		fmt.Println("ok", name)
	}
}

func main() {
	defer func() { recover() }()
	func() {
		f := reflect.MakeFunc(reflect.TypeOf((func())(nil)), func([]reflect.Value) []reflect.Value {
			report("MakeFunc", recover())
			return nil
		}).Interface().(func())
		defer f()
		panic("boom")
	}()
}
-- main.stdout --
ok MakeFunc
