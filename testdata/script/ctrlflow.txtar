env GARBLE_EXPERIMENTAL_CONTROLFLOW=1
exec garble -literals -debugdir=debug -seed=0002deadbeef build -o=main$exe

stderr '"test/main.func1" function has no effect on the resulting binary'

exec ./main
cmp stderr main.stderr

# simple check to ensure that control flow will work. Must be a minimum of 10 goto's
grep 'goto _s2a_l10' $WORK/debug/garbled/test/main/GARBLE_controlflow.go

# obfuscated function must be removed from original file
! grep 'main\(\)' $WORK/debug/garbled/test/main/garble_main.go
# original file must contains empty function
grep '\_\(\)' $WORK/debug/garbled/test/main/garble_main.go

# obfuscated file must contains interface for unexported interface emulation
# GoString uses the global method hash for this fixture's fixed seed.
grep 'LvNmTg\(\) string' $WORK/debug/garbled/test/main/GARBLE_controlflow.go
! grep 'GoString\(\) string' $WORK/debug/garbled/test/main/GARBLE_controlflow.go
grep 'String\(\) string' $WORK/debug/garbled/test/main/GARBLE_controlflow.go

# control flow obfuscation should work correctly with literals obfuscation
! binsubstr main$exe 'correct name'


# check xor hardening
grep '\(\w+ \^ \d+\)' $WORK/debug/garbled/test/main/GARBLE_controlflow.go
# check delegate table hardening
grep 'func\(int\) int' $WORK/debug/garbled/test/main/GARBLE_controlflow.go

-- go.mod --
module test/main

go 1.23
-- garble_main.go --
package main

import (
	"encoding/binary"
	"encoding/hex"
	"hash/crc32"
	"slices"
	"unsafe"

	"test/main/named"
)

//garble:controlflow flatten_passes=0 junk_jumps=max block_splits=max
func func1() {}

//garble:controlflow flatten_passes=1 junk_jumps=max block_splits=max flatten_hardening=xor
func xorHardeningTest(i int) int {
	if i == 0 {
		return 1
	}
	return i * 2
}

//garble:controlflow flatten_passes=1 junk_jumps=max block_splits=max flatten_hardening=delegate_table
func delegateHardeningTest(i int) int {
	if i == 0 {
		return 1
	}
	return i * 3
}

// Trigger multiple hardening using multiple anonymous functions
//
//garble:controlflow flatten_passes=1 junk_jumps=max block_splits=max flatten_hardening=xor,delegate_table
func multiHardeningTest(i int) int {
	notZero := func(i int) bool {
		return i != 0
	}
	isZero := func(i int) bool {
		return i == 0
	}
	multiply := func(i int) int {
		return i * 4
	}

	if !notZero(i) && isZero(i) {
		return 1
	}
	return multiply(i)
}

//garble:controlflow
func ModifyValue() {
	var a int = 42
	var p *int = &a

	println("Value of a:", a)

	var up unsafe.Pointer = unsafe.Pointer(p)

	var p2 *int = (*int)(up)

	*p2 = 100

	println("New value of a:", a)
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func rangeFunction() {
	seq := func(yield func(int) bool) {
		for i := 1; i <= 5; i++ {
			if !yield(i) {
				println("stopped at", i)
				return
			}
		}
	}
	for n := range seq {
		println("yielded", n)
		if n == 3 {
			break
		}
	}
	pairs := func(yield func(int, string) bool) {
		for i := 0; i < 2; i++ {
			if !yield(i, "pair") {
				return
			}
		}
	}
	for n, label := range pairs {
		println("pair", n, label)
	}
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func namedResultDefer() (result int) {
	defer func() { result = 42 }()
	return
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func namedResultsBranches(early bool) (left, right int) {
	defer func() { left += 7; right *= 2 }()
	if early {
		return 3, 5
	}
	left, right = 11, 13
	return
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func namedClosureResult() int {
	f := func() (result int) {
		defer func() { result += 10 }()
		return 2
	}
	return f()
}

func applyReverse(f func([]int), values []int) { f(values) }

// scoreList is a named slice type, so slicing a composite literal of it must
// keep the named type for method calls and interface conversions.
type scoreList []int

func (s scoreList) Total() int {
	total := 0
	for _, v := range s {
		total += v
	}
	return total
}

func keepShadow() {
	slices := struct{ Field int }{7}
	if slices.Field != 7 {
		panic("shadowed package name changed")
	}
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func reverseDuringRange(values []int) []int {
	seen := make([]int, 0, len(values))
	for i, value := range values {
		if i == 0 {
			slices.Reverse(values)
			undo := slices.Reverse[[]int]
			undo(values)
			applyReverse(slices.Reverse[[]int], values)
			applyReverse(slices.Reverse[[]int], values)
			slices.Reverse(values)
		}
		seen = append(seen, value)
	}
	return seen
}

type genericBox[T any] struct {
	value T
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0
func (b genericBox[T]) pick(def T, use bool) T {
	if use {
		return b.value
	}
	return def
}

//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0
func (b *genericBox[T]) set(value T) {
	b.value = value
}

// genericBoxCheck is not flattened; it calls the generated generic methods as
// plain Go code.
func genericBoxCheck() {
	boxed := genericBox[int]{value: 5}
	println(boxed.pick(9, true), boxed.pick(9, false))
	boxed.set(6)
	println(boxed.value)
}

// zeroValues is an array type, so its zero value has to be written as an empty
// composite literal; there is no nil array value to convert from.
type zeroValues [3]int

// zeroArrayValues materializes zero values of unnamed, named and nested array
// types, and one behind an interface, inside a flattened function.
//
//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func zeroArrayValues() zeroValues {
	unnamed := [3]int{}
	unnamed[1] = 5
	if unnamed != ([3]int{0, 5, 0}) {
		panic("unnamed zero array changed")
	}
	nested := [2][2]int{}
	if nested != ([2][2]int{}) {
		panic("nested zero array changed")
	}
	var boxed any = [2]int{}
	if got, ok := boxed.([2]int); !ok || got != ([2]int{}) {
		panic("zero array behind an interface changed")
	}
	return zeroValues{}
}

// zeroArrayResult returns a zero array, so the value is materialized as a
// return operand instead of an assignment target.
//
//garble:controlflow flatten_passes=1 junk_jumps=0 block_splits=0 trash_blocks=0
func zeroArrayResult() [2]int {
	return [2]int{}
}

//garble:controlflow flatten_passes=1 junk_jumps=10 block_splits=10 trash_blocks=32
func main() {
	keepShadow()
	if got := reverseDuringRange([]int{11, 22, 33, 44, 55}); !slices.Equal(got, []int{11, 44, 33, 22, 11}) {
		panic("reversed slice range values changed")
	}
	if got := namedResultDefer(); got != 42 {
		panic("deferred named result was lost")
	}
	if a, b := namedResultsBranches(true); a != 10 || b != 10 {
		panic("deferred early-return results were lost")
	}
	if a, b := namedResultsBranches(false); a != 18 || b != 26 {
		panic("deferred bare-return results were lost")
	}
	if got := namedClosureResult(); got != 12 {
		panic("deferred closure result was lost")
	}
	// Reference to the unexported interface triggers creation of a new interface
	// with a list of all functions of the private interface
	endian := binary.LittleEndian
	println(endian.String())
	println(endian.GoString())
	println(endian.Uint16([]byte{0, 1}))

	// Switch statement should be simplified to if statements
	switch endian.String() {
	case "LittleEndian":
		println("correct name")
	default:
		panic("unreachable")
	}

	// Indirect import "hash" package
	hash := crc32.New(crc32.IEEETable)
	hash.Write([]byte("1"))
	hash.Write([]byte("2"))
	hash.Write([]byte("3"))

	println(hex.EncodeToString(hash.Sum(nil)))

	println(xorHardeningTest(0))
	println(delegateHardeningTest(0))
	println(multiHardeningTest(0))
	ModifyValue()
	rangeFunction()

	genericBoxCheck()

	if got := (scoreList{3, 4}).Total(); got != 7 {
		panic("named slice method call changed")
	}
	var scored interface{ Total() int } = scoreList{5, 6}
	if got := scored.Total(); got != 11 {
		panic("named slice interface conversion changed")
	}
	// A named slice type of another package keeps its methods as well.
	if got := (named.Scores{1, 2}).Total(); got != 3 {
		panic("exported foreign named slice changed")
	}

	if got := zeroArrayValues(); got != (zeroValues{}) {
		panic("named zero array value changed")
	}
	if got := zeroArrayResult(); got != ([2]int{}) {
		panic("zero array result changed")
	}
}

-- named/scores.go --
package named

// Scores is an exported named slice type used from a flattened function.
type Scores []int

func (s Scores) Total() int {
	total := 0
	for _, v := range s {
		total += v
	}
	return total
}
