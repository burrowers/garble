exec garble -embed build
exec ./main$exe
cmp stdout want.stdout
! binsubstr main$exe 'GARBLE_FS_SECRET_194'
env GOGARBLE=test/main
exec garble -embed build
exec ./main$exe
cmp stdout want.stdout
! binsubstr main$exe 'GARBLE_FS_SECRET_194'
exec garble -embed -literals build
exec ./main$exe
cmp stdout want.stdout
! binsubstr main$exe 'GARBLE_FS_SECRET_194'

-- go.mod --
module test/main

go 1.23
-- main.go --
package main

import (
 "embed"
 "fmt"
 "io"
 "io/fs"
 "test/main/plain"
)

//go:embed static
var assets embed.FS

type aliasFS = embed.FS

//go:embed static
var aliased aliasFS

func main() {
 data, _ := assets.ReadFile("static/a.txt")
 aliasData, _ := aliased.ReadFile("static/a.txt")
 if string(data) != string(aliasData) { panic("alias differs") }
 nested, _ := assets.ReadFile("static/sub/nested.txt")
 fmt.Printf("nested: %s", nested)
 fmt.Printf("read: %s", data)
 plainData, _ := plain.Data.ReadFile("ordinary.txt")
 fmt.Printf("plain: %s", plainData)
 f, _ := assets.Open("static/a.txt")
 info, _ := f.Stat()
 fmt.Printf("size: %d\n", info.Size())
 at := f.(io.ReaderAt)
 buf := make([]byte, 6)
 at.ReadAt(buf, 0)
 fmt.Printf("at: %s\n", buf)
 seek := f.(io.Seeker)
 seek.Seek(7, io.SeekStart)
 rest, _ := io.ReadAll(f)
 fmt.Printf("rest: %s", rest)
 dir, _ := assets.ReadDir("static")
 info, _ = dir[0].Info()
 fmt.Printf("dir: %s %d\n", dir[0].Name(), info.Size())
 fs.WalkDir(assets, ".", func(path string, d fs.DirEntry, err error) error {
  if err != nil { panic(err) }
  fmt.Printf("walk: %s\n", path)
  return nil
 })
}
-- static/a.txt --
GARBLE_FS_SECRET_194
-- static/sub/nested.txt --
nested
-- plain/plain.go --
package plain
import "embed"
//go:embed ordinary.txt
var Data embed.FS
-- plain/ordinary.txt --
ordinary
-- want.stdout --
nested: nested
read: GARBLE_FS_SECRET_194
plain: ordinary
size: 21
at: GARBLE
rest: FS_SECRET_194
dir: a.txt 21
walk: .
walk: static
walk: static/a.txt
walk: static/sub
walk: static/sub/nested.txt
