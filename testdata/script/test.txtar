-- exporttest/foo.go --
package exporttest

type foo int

-- exporttest/export_test.go --
package exporttest

type Foo = foo

-- exporttest/foo_test.go --
package exporttest_test

import "testing"

func TestFoo(t *testing.T) {}

-- mocks/mock.go --
// Package mocks imports bar while also being imported by bar's external test.
// Since bar has in-package tests, mocks is compiled only as a test variant
// "test/bar/mocks [test/bar.test]", which garble must resolve from its bare
// import path when building the test binary.
package mocks

import (
	_ "unsafe" // for go:linkname

	"test/bar"
)

func Foo() string { return bar.LocalFoo() }

// linkedValue is called through the external test package's directive of the
// same name, which is the only reference the linker sees.
//
//go:linkname linkedValue test/bar_test.linkedValue
func linkedValue() string { return "linked" }

type Payload struct {
	Value string
}
