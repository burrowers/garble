# build the test binary
env GARBLE_CACHE=${WORK}/garble-cache
exec garble test -c
! stdout 'PASS'
binsubstr bar.test$exe 'TestFoo' 'TestSeparateFoo'
! binsubstr bar.test$exe 'LocalFoo|ImportedVar|OriginalFuncName'

# A cached test main has GoFiles but no CompiledGoFiles in go list output.
# Retain GOCACHE and force relinking after evicting reflection metadata.
rm garble-cache
exec garble test -c -ldflags=-X=main.unused=changed

# run the tests; OriginalFuncName should be obfuscated
exec ./bar.test -test.v
stdout 'test declaration:'
! stdout 'test declaration: .*\.Test(Foo|Main)$'
stdout 'PASS.*TestFoo'
stdout 'PASS.*TestSeparateFoo'
stdout 'PASS.*TestLinkedFromTestVariant'
stdout 'PASS.*TestMockedFoo'
stdout 'package bar, func name:'
stdout 'package bar_test, func name:'
! stdout 'OriginalFuncName'

# A deferred helper must skip the panic implementation and report its caller.
cp stdout test.stdout
exec garble reverse -test . test.stdout
stdout 'panic_helper_test.go:6: recovered-helper'

# Compare argument forwarding with plain Go using the same payload.
exec garble test -v . -args payload -overlay=missing.json
stdout '^--- PASS: TestArgs \('

go test -v . -args payload -overlay=missing.json
stdout '^--- PASS: TestArgs \('
stdout 'PASS.*TestFoo'
stdout 'PASS.*TestSeparateFoo'
stdout 'package bar, func name: test/bar\.OriginalFuncName'
stdout 'package bar_test, func name: test/bar\.OriginalFuncName'

[short] stop # no need to verify this with -short

# Also check that many packages test fine, including a main package and multiple
# test packages.
#
# Exporttest is special, as it:
#
#  * uses an external test package
#  * exports unexported APIs via export_test.go
#  * is imported by another package, also tested via "./..."
#
# The combination of those used to result in "refusing to list non-dependency
# package" errors, which we've currently worked around.
exec garble test ./... -test.v -tags testprefix
stdout 'ok\s+test/bar\s'
stdout 'PASS.*TestFoo'
stdout 'PASS.*TestMain'
stdout 'PASS.*TestSeparateFoo'
stdout 'SKIP.*TestWithFlag'
stdout 'package bar, func name:'
stdout 'package bar_test, func name:'
! stdout 'OriginalFuncName'
stdout '\?\s+test/bar/mocks\s'
stdout '\?\s+test/bar/somemain\s'
stdout 'ok\s+test/bar/somemaintest\s'
stdout 'ok\s+test/bar/sometest\s'
stdout 'ok\s+test/bar/exporttest\s'

# verify that an unknown test flag does not consume a following build flag
exec garble test . -withflag -tags testprefix -v
stdout 'PASS.*TestWithFlag'
stdout 'PASS.*TestTaggedFlag'

# fuzzing must retain edge coverage guidance under obfuscation
exec garble -seed=AAAAAAAAAAA test -fuzz=FuzzGuided -fuzztime=1x -run='^$' .
stdout 'gathering baseline coverage:'
! stdout 'not built with coverage instrumentation'

go test -fuzz=FuzzGuided -fuzztime=1x -run='^$' .
stdout 'gathering baseline coverage:'

-- go.mod --
module test/bar

go 1.23
-- bar.go --
package bar

import "runtime"

import _ "test/bar/exporttest"

func LocalFoo() string { return "Foo" }

var ImportedVar = "imported var value"

// OriginalFuncName returns its own func name.
func OriginalFuncName() string {
	pc, _, _, _ := runtime.Caller(0)
	fn := runtime.FuncForPC(pc)
	return fn.Name()
}

-- bar_test.go --
package bar

import (
	"encoding/xml"
	"reflect"
	"runtime"
	"testing"
)

type Book struct {
	XMLName struct{} `xml:"book"`
	Title   string   `xml:",chardata"`
}

func TestFoo(t *testing.T) {
	for _, fn := range []any{TestFoo, TestMain} {
		name := runtime.FuncForPC(reflect.ValueOf(fn).Pointer()).Name()
		t.Logf("test declaration: %s", name)
	}
	data, err := xml.Marshal(&Book{Title: "My book"})
	if err != nil || string(data) != "<book>My book</book>" {
		t.Fatalf("XML reflection: %s, %v", data, err)
	}
	t.Log(ImportedVar)
	if LocalFoo() != "Foo" {
		t.FailNow()
	}
	t.Logf("package bar, func name: %s", OriginalFuncName())
}

func FuzzGuided(f *testing.F) {
	f.Add("seed")
	f.Fuzz(func(t *testing.T, input string) {
		if input == "seed" {
			t.Log("seed-ok")
		}
	})
}

-- reflect_error_test.go --
package bar

import (
	"reflect"
	"runtime"
	"testing"
)

func TestReflectValueErrorMethod(t *testing.T) {
	for _, tc := range []struct {
		name   string
		method any
		call   func()
	}{
		{"Bool", reflect.Value.Bool, func() { reflect.ValueOf(1).Bool() }},
		{"SetInt", reflect.Value.SetInt, func() { reflect.Value{}.SetInt(1) }},
	} {
		t.Run(tc.name, func(t *testing.T) {
			want := runtime.FuncForPC(reflect.ValueOf(tc.method).Pointer()).Name()
			defer func() {
				value, ok := recover().(*reflect.ValueError)
				if !ok {
					t.Fatal("expected ValueError")
				}
				if value.Method != want {
					t.Errorf("ValueError.Method = %q, want calling method %q", value.Method, want)
				}
			}()
			tc.call()
		})
	}
}

-- panic_helper_test.go --
package bar

import "testing"

func TestPanicHelper(t *testing.T) {
	panicHelper(t)
}

func panicHelper(t *testing.T) {
	t.Helper()
	defer func() {
		t.Helper()
		if recover() != nil {
			t.Log("recovered-helper")
		}
	}()
	panic("helper panic")
}

-- tagged_test.go --
//go:build testprefix

package bar

import "testing"

func TestTaggedFlag(t *testing.T) {}
-- bar_separate_test.go --
package bar_test

import (
	"flag"
	"reflect"
	"testing"

	_ "unsafe" // for go:linkname

	"test/bar"
	"test/bar/mocks"
)

var withFlag = flag.Bool("withflag", false, "")

// The one-argument directive names the symbol of this package, which mocks
// writes from its own test variant. Both sides have to agree on the
// obfuscated name or the test binary does not link.
//
//go:linkname linkedValue
func linkedValue() string

func TestSeparateFoo(t *testing.T) {
	t.Log(bar.ImportedVar)
	if bar.LocalFoo() != "Foo" {
		t.FailNow()
	}
	t.Logf("package bar_test, func name: %s", bar.OriginalFuncName())
}

func TestLinkedFromTestVariant(t *testing.T) {
	if got := linkedValue(); got != "linked" {
		t.Fatalf("linkedValue() = %q, want %q", got, "linked")
	}
}

func TestMockedFoo(t *testing.T) {
	if mocks.Foo() != "Foo" {
		t.FailNow()
	}
	// Reflecting a type of a package compiled only as a test variant must
	// resolve the variant rather than crash on a missing bare package.
	field := reflect.TypeOf(mocks.Payload{}).Field(0)
	if field.Name != "Value" {
		t.Fatalf("reflected field name: %s", field.Name)
	}
}

func TestWithFlag(t *testing.T) {
	if !*withFlag {
		t.Skip()
	}
}

func TestArgs(t *testing.T) {
	if flag.NArg() == 0 {
		t.Skip("no arguments")
	}
	want := []string{"payload", "-overlay=missing.json"}
	if got := flag.Args(); !reflect.DeepEqual(got, want) {
		t.Fatalf("flag.Args() = %q, want %q", got, want)
	}
}

-- main_test.go --
package bar

import (
	"os"
	"testing"
)

func TestMain(m *testing.M) {
	os.Exit(m.Run())
}

-- somemain/main.go --
