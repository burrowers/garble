func main() {}

-- somemaintest/main_test.go --
package main

import "testing"

func TestMain(t *testing.T) {}

-- sometest/foo_test.go --
package sometest

import "testing"

func TestFoo(t *testing.T) {}

-- exporttest/foo.go --
package exporttest

type foo int

-- exporttest/export_test.go --
package exporttest

type Foo = foo

-- exporttest/foo_test.go --
package exporttest_test

import "testing"

func TestFoo(t *testing.T) {}

-- mocks/mock.go --
// Package mocks imports bar while also being imported by bar's external test.
// Since bar has in-package tests, mocks is compiled only as a test variant
// "test/bar/mocks [test/bar.test]", which garble must resolve from its bare
// import path when building the test binary.
package mocks

import (
	_ "unsafe" // for go:linkname

	"test/bar"
)

func Foo() string { return bar.LocalFoo() }

// linkedValue is called through the external test package's directive of the
// same name, which is the only reference the linker sees.
//
//go:linkname linkedValue test/bar_test.linkedValue
func linkedValue() string { return "linked" }

type Payload struct {
	Value string
}

-- asmtest/asmtest_amd64.go --
//go:build amd64

package asmtest

// off returns the offset of Outer's B field, from go_asm.h.
func off() int64

-- asmtest/asmtest_amd64.s --
#include "textflag.h"
#include "go_asm.h"

TEXT ·off(SB), NOSPLIT, $0-8
	MOVQ $Outer_B, AX
	MOVQ AX, ret+0(FP)
	RET

-- asmtest/asmtest_other.go --
//go:build !amd64

package asmtest

// off reads a go_asm.h constant on amd64, which only that architecture
// assembles; elsewhere the package has to build without the offset.
func off() int64 { return 8 }

-- asmtest/asmtest_test.go --
package asmtest

import "testing"

// Outer is declared in the test files only, so the variant's go_asm.h has its
// B field offset while a plain compile of this package has no such type and
// fails to assemble.
type Outer struct {
	embedded
	B int64
}

type embedded struct{ A int32 }

func TestOff(t *testing.T) {
	if got := off(); got != 8 {
		t.Fatalf("offset = %d, want 8", got)
	}
}
