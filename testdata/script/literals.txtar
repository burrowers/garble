-- global_init.go --
package main

import "test/main/global_ref"

var initEvents int

type aggregateRecord struct {
	Text   string
	Count  int
	Nested [2]string
}

var aggregate = aggregateRecord{Text: "an eagerly initialized aggregate", Count: 3, Nested: [2]string{1: "a nested aggregate string"}}
var aggregateAddress = &aggregate
var aggregateArray = [...]aggregateRecord{{"an array aggregate string", 4, [2]string{"nested array string", "short"}}}
var deadAggregate = [2]string{"a dead array aggregate string", "another dead array string"}
var deadRecord = aggregateRecord{Text: "a dead struct aggregate string"}
var aggregateEffect = aggregateRecord{Text: literalGlobalFactory()}
var literalMap = map[string]rune{"an eagerly initialized map key": 'x'}
var literalMapAddress = &literalMap
var deadLiteralMap = map[string]rune{"a dead constant map key": 'y'}
var mapScheduled = observeMap()
var unusedMapEffect = map[string]string{"an unused map with side effects": literalGlobalFactory()}
var addressed = "an addressable initialized literal"
var addressBeforeUse = &addressed
var scheduled = observeScheduled()
var dependency = "initialized before its dependent"
var userFactory = literalGlobalFactory()
var unusedEffect = literalGlobalFactory()
var mixedConstant, mixedEffect = "a mixed constant initializer", literalGlobalFactory()
var _ = literalGlobalFactory()

func observeScheduled() string {
	if dependency != "initialized before its dependent" {
		panic("literal dependency scheduling changed")
	}
	initEvents++
	return dependency
}

func observeMap() bool {
	if literalMap["an eagerly initialized map key"] != 'x' {
		panic("map initialization dependency changed")
	}
	return true
}

func literalGlobalFactory() string {
	initEvents++
	return "side effects in a user literal factory"
}

func init() {
	if aggregateAddress != &aggregate || aggregate.Text != "an eagerly initialized aggregate" || aggregate.Nested[1] != "a nested aggregate string" || aggregate.Count != 3 || aggregateArray[0].Count != 4 || aggregateArray[0].Text != "an array aggregate string" {
		panic("aggregate address or eager initialization changed")
	}
	aggregateAddress.Nested[1] = "mutated aggregate field"
	if aggregate.Nested[1] != "mutated aggregate field" || aggregateEffect.Text != userFactory {
		panic("aggregate mutation or side effects changed")
	}
	if initEvents != 7 || scheduled != dependency || mixedConstant != "a mixed constant initializer" || mixedEffect != userFactory {
		panic("literal initializer side effects changed")
	}
	if !mapScheduled || literalMapAddress != &literalMap || (*literalMapAddress)["an eagerly initialized map key"] != 'x' {
		panic("map address or eager initialization changed")
	}
	literalMap["an eagerly initialized map key"] = 'z'
	if (*literalMapAddress)["an eagerly initialized map key"] != 'z' {
		panic("map mutation changed")
	}
	if addressBeforeUse != &addressed || *addressBeforeUse != "an addressable initialized literal" {
		panic("literal global address or eager value changed")
	}
	*addressBeforeUse = "mutated after initialization"
	if addressed != "mutated after initialization" {
		panic("literal global mutation changed")
	}
	global_ref.Check()
}
