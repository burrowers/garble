package global_ref

import (
	_ "test/main/imp_var"
	_ "unsafe"
)

//go:linkname linkedLiteral test/main/imp_var.LinknameGlobal
var linkedLiteral string

func Check() {
	if linkedLiteral != "a global referenced only by linkname" {
		panic("linknamed literal initializer removed")
	}
	linkedLiteral = "mutation through linkname"
	if linkedLiteral != "mutation through linkname" {
		panic("linknamed literal mutation changed")
	}
}
