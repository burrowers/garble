-- consumer/main.go --
package main

import (
	"fmt"
	"io"
	"strings"
	"unicode"

	"example.com/exported"
	"example.com/exported/support"
)

type count int

func main() {
	if library.Dependency() != 7 {
		panic("tagged dependency")
	}
	box := library.New(count(5))
	var writer io.Writer = box
	n, err := writer.Write([]byte("abc"))
	if err != nil {
		panic(err)
	}
	box.Embedded = support.Embedded{Label: "changed"}
	box.Value = 23
	box.Visible = 29
	var structural struct{ Label string } = box.Embedded
	fmt.Println(box.Sum(), n, box.Value, box.Visible, box.Label, box.Description(), structural.Label)

	result := library.Result()
	var total interface{ Total() int } = result
	result.Value = 31
	fmt.Println(result.Value, result.Total(), total.Total())

	library.PublicVar = 41
	fmt.Println(library.PublicConst, library.PublicVar)
	if library.Message() != "opaque exported literal:"+unicode.Version {
		panic(library.Message())
	}
	fmt.Print(strings.TrimSuffix(library.State(), "\n"))
}

-- consumer/want.stdout --
36 3 23 29 changed changed changed
31 50 36
7 41
bza:az:asset
