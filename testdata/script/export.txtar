# Export source, not a binary: a separate module must build it with stock Go.
cd source
exec go mod download example.com/exporttagdep
cp LICENSE LICENSE-MIT.md
cp LICENSE NOTICE.txt
! exec garble -tiny export $WORK/rejected ./...
stderr 'export does not support'
! exists $WORK/rejected
env GOFLAGS=-race
! exec garble export $WORK/rejected ./...
stderr 'empty GOFLAGS'
env GOFLAGS=
! exec garble export $WORK/rejected ./...
stderr 'missingWithoutTag'
! exists $WORK/rejected
! exec garble export -tags=exporttag,linkname $WORK/rejected ./...
stderr 'export does not support go:linkname directives in example.com/exported'
! exists $WORK/rejected
! exec garble export -tags=exporttag,linknamestd $WORK/rejected ./...
stderr 'export does not support go:linknamestd directives in example.com/exported'
! exists $WORK/rejected
! exec garble export -tags=exporttag,nestedinternal $WORK/rejected ./...
stderr 'export does not support nested internal packages: example.com/exported/internal/a/internal/nested'
! exists $WORK/rejected
! exec garble export -tags=adjacentinternal $WORK/rejected ./internal/internal/nested
stderr 'export does not support nested internal packages: example.com/exported/internal/internal/nested'
! exists $WORK/rejected
exec garble -seed=AAAAAAAAAAA export -tags=exporttag $WORK/out ./...

# Public paths, source file ordering, module metadata and embedded assets survive.
cmp go.mod $WORK/out/example.com/exported/go.mod
cmp go.sum $WORK/out/example.com/exported/go.sum
! exists $WORK/out/example.com/exporttagdep
cmp LICENSE $WORK/out/example.com/exported/LICENSE
cmp LICENSE-MIT.md $WORK/out/example.com/exported/LICENSE-MIT.md
cmp NOTICE.txt $WORK/out/example.com/exported/NOTICE.txt
cmp data/message.txt $WORK/out/example.com/exported/data/message.txt
exists $WORK/out/example.com/exported/api.go
exists $WORK/out/example.com/exported/a_init.go
exists $WORK/out/example.com/exported/z_init.go
exists $WORK/out/example.com/exported/support/types.go
! grep 'privateLicenseAlgorithm|IMPLEMENTATION_SECRET_COMMENT' $WORK/out/example.com/exported/license.go
! exists $WORK/out/example.com/exported/NOTICE.GO
! exists $WORK/out/example.com/exported/internal/helperpath/license.go
! exists $WORK/out/example.com/exported/internal/helperpath
! exists $WORK/out/example.com/exported/notag.go
# The internal boundary must stay in place even though its child is renamed.
grepfiles $WORK/out/example.com/exported/internal '[\\/]internal[\\/][^\\/]+[\\/]helper\.go$'

# Inspect every emitted Go file, including the renamed internal package.
exec gofmt $WORK/out
stdout 'Copyright 2026 Export Test Authors'
stdout 'SPDX-License-Identifier: BSD-3-Clause'
stdout 'Package library exercises source export\.'
stdout 'New constructs a Box\.'
stdout 'EMBEDDED_SELECTOR_DOC'
stdout 'EMBEDDED_PLAIN_DOC'
stdout 'EMBEDDED_POINTER_DOC'
stdout 'EMBEDDED_GENERIC_DOC'
stdout 'EMBEDDED_MULTI_GENERIC_DOC'
stdout 'Permission is hereby granted, free of charge'
stdout 'THE SOFTWARE IS PROVIDED WITHOUT WARRANTY'
stdout '//go:embed data/message.txt'
! stdout '\b(privateOffset|privateOrder|privatePayload|privateEmbedded|privateField|privateMethod|privateResult|privateResultField|privateIdentity|selectedValue|InternalValue|InternalAdjust)\b'
! stdout 'IMPLEMENTATION_COMMENT_MUST_DISAPPEAR|PRIVATE_DECLARATION_COMMENT_MUST_DISAPPEAR|INTERNAL_IMPLEMENTATION_SECRET_COMMENT|privateLicenseInternal'
! stdout 'original-source\.go|//line |/\*line |go:build|missingWithoutTag'
# Do not retain the original blank lines between implementation statements.
! stdout '\n\n\treturn\b'

# Literal decoding must also be ordinary Go source, not patched-toolchain output.
exec garble -literals -seed=AAAAAAAAAAA export -tags=exporttag $WORK/encoded ./...
! grep 'privateLicenseAlgorithm|IMPLEMENTATION_SECRET_COMMENT|license source secret' $WORK/encoded/example.com/exported/license.go
! exists $WORK/encoded/example.com/exported/NOTICE.GO
! exists $WORK/encoded/example.com/exported/internal/helperpath
grep 'Copyright 2026 Export Test Authors\n// Permission is hereby granted, free of charge.*\n// THE SOFTWARE IS PROVIDED WITHOUT WARRANTY' $WORK/encoded/example.com/exported/api.go
grep 'EMBEDDED_SELECTOR_DOC' $WORK/encoded/example.com/exported/api.go
grep 'EMBEDDED_PLAIN_DOC' $WORK/encoded/example.com/exported/api.go
grep 'EMBEDDED_POINTER_DOC' $WORK/encoded/example.com/exported/api.go
grep 'EMBEDDED_GENERIC_DOC' $WORK/encoded/example.com/exported/api.go
grep 'EMBEDDED_MULTI_GENERIC_DOC' $WORK/encoded/example.com/exported/api.go
grep 'opaque exported literal' $WORK/out/example.com/exported/literal.go
! grep 'opaque exported literal' $WORK/encoded/example.com/exported/literal.go

# Multi-line godoc must stay one attached comment group.
grep 'New constructs a Box\.\n// Its result supports ordinary Go interfaces\.' $WORK/out/example.com/exported/api.go

# Refuse to overwrite an existing export, leaving its metadata intact.
! exec garble -seed=AAAAAAAAAAA export -tags=exporttag $WORK/out ./...
stderr 'exist'
cmp go.mod $WORK/out/example.com/exported/go.mod

cd $WORK
rm source
cd consumer
exec go run -mod=mod -tags=exporttag .
cmp stdout want.stdout
cp encoded.mod go.mod
exec go run -mod=mod -tags=exporttag .
cmp stdout want.stdout

-- source/go.mod --
module example.com/exported

go 1.23

require example.com/exporttagdep v1.0.0

-- source/LICENSE --
Copyright 2026 Export Test Authors
SPDX-License-Identifier: BSD-3-Clause
Redistribution and use in source and binary forms are permitted.

-- source/api.go --
// Copyright 2026 Export Test Authors
// SPDX-License-Identifier: BSD-3-Clause

// Package library exercises source export.
package library

import (
	_ "embed"

	dep "example.com/exporttagdep"

	_ "example.com/exported/internal/a"
	_ "example.com/exported/internal/b"
	"example.com/exported/internal/helperpath"
	labels "example.com/exported/support"
	"example.com/exported/support/state"
)

// Dependency exercises a tagged API in an untouched third-party module.
func Dependency() int { return dep.Tagged() }

// PublicConst remains available to consumers.
const PublicConst = 7

// PublicVar remains writable by consumers.
var PublicVar = 11

// Copyright 2026 Export Test Authors
// Permission is hereby granted, free of charge, to any person obtaining a copy.
// THE SOFTWARE IS PROVIDED WITHOUT WARRANTY OF ANY KIND.
const privateOffset = 2

var privateOrder string

//go:embed data/message.txt
var privatePayload string

type privateEmbedded struct {
	Visible int
}

// Box preserves exported and promoted fields across generic instantiations.
type Box[T ~int] struct {
	// EMBEDDED_SELECTOR_DOC
	labels.Embedded
	privateEmbedded
	Value        T
	privateField int
}

type ExportBase struct{}
type PointerBase struct{}
type GenericBase[A, B any] struct{}

// EmbeddedDocs exercises the anonymous-field type shapes.
type EmbeddedDocs[T any] struct {
	// EMBEDDED_PLAIN_DOC
	ExportBase
	// EMBEDDED_POINTER_DOC
	*PointerBase
	// EMBEDDED_GENERIC_DOC
	*labels.Generic[T]
	// EMBEDDED_MULTI_GENERIC_DOC
	GenericBase[T, int]
}

// New constructs a Box.
// Its result supports ordinary Go interfaces.
func New[T ~int](value T) *Box[T] {
	// IMPLEMENTATION_COMMENT_MUST_DISAPPEAR
	box := &Box[T]{
		Embedded:        labels.Embedded{Label: "label"},
		privateEmbedded: privateEmbedded{Visible: 13},
		Value:           privateIdentity(value),
		privateField:    privateOffset,
	}

	return box
}

// Sum returns a value computed through the internal package.
func (box *Box[T]) Sum() T {
	return box.Value + T(box.privateMethod())
}

// Write implements io.Writer without importing io in this package.
func (box *Box[T]) Write(data []byte) (int, error) {
	box.privateField += len(data)
	return len(data), nil
}

// PRIVATE_DECLARATION_COMMENT_MUST_DISAPPEAR
//
//line original-source.go:321
func (box *Box[T]) privateMethod() int {
	value := arithmetic.InternalValue{Number: box.privateField}

	return arithmetic.InternalAdjust(value) + selectedValue
}

func privateIdentity[T any](value T) T {
	return value
}

type privateResult struct {
	Value              int
	privateResultField int
}

// Result returns a private type whose public surface is still usable.
func Result() privateResult {
	return privateResult{Value: 17, privateResultField: 19}
}

// Total is callable even though its receiver type is private.
func (result privateResult) Total() int {
	return result.Value + result.privateResultField
}

// State reports init order and the embedded asset.
func State() string {
	return state.Order + ":" + privateOrder + ":" + privatePayload
}

