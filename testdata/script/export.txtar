-- source/support/types.go --
// Package support contains public types used in the exported API.
package support

// Embedded is embedded by a type in another package.
type Embedded struct {
	Label string
}

type Generic[T any] struct{}

// Description is promoted through the embedded field.
func (value Embedded) Description() string {
	return value.Label
}

-- source/internal/helperpath/helper.go --
package arithmetic

type InternalValue struct {
	Number int
}

func InternalAdjust(value InternalValue) int {
	return value.Number * 2
}

