diff --git a/cmd/compile/internal/ir/abi.go b/cmd/compile/internal/ir/abi.go
index ebe0fbfb2a..c8c6363960 100644
--- a/cmd/compile/internal/ir/abi.go
+++ b/cmd/compile/internal/ir/abi.go
@@ -7,6 +7,7 @@ package ir
 import (
 	"cmd/compile/internal/base"
 	"cmd/internal/obj"
+	"cmd/internal/objabi"
 )
 
 // InitLSym defines f's obj.LSym and initializes it based on the
@@ -64,15 +65,17 @@ func setupTextLSym(f *Func, flag int) {
 	// runtime.reflectcall is an assembly function which tailcalls
 	// WRAPPER functions (runtime.callNN). Its ABI wrapper needs WRAPPER
 	// flag as well.
-	fnname := f.Sym().Name
-	if base.Ctxt.Pkgpath == "runtime" && fnname == "reflectcall" {
+	if isReflectCallWrapper(base.Ctxt.Pkgpath, f.Sym().Name) {
 		flag |= obj.WRAPPER
-	} else if base.Ctxt.Pkgpath == "reflect" {
-		switch fnname {
-		case "callReflect", "callMethod":
-			flag |= obj.WRAPPER
-		}
 	}
 
 	base.Ctxt.InitTextSym(f.LSym, flag, f.Pos())
 }
+
+func isReflectCallWrapper(pkgPath, fnname string) bool {
+	switch objabi.OriginalFuncName(pkgPath + "." + fnname) {
+	case "runtime.reflectcall", "reflect.callReflect", "reflect.callMethod":
+		return true
+	}
+	return false
+}
