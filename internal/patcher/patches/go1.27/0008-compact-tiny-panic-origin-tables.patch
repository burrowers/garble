+// tinyFilename discards physical filenames before assigning global file indices.
+func tinyFilename(name string) string {
+	base := name[strings.LastIndexByte(name, '/')+1:]
+	if strings.HasPrefix(base, "p_") && strings.HasSuffix(base, ".go") {
+		return base[2 : len(base)-3]
+	}
+	return "?"
+}
+
+func (state *pclntab) generateTinyFilenameTabs(ctxt *Link, compUnits []*sym.CompilationUnit, funcs []loader.Sym) []uint32 {
+	state.tinyFileIndices = make(map[string]int32)
+	var files []string
+	var offsets []uint32
+	var size int64
+	walkFilenames(ctxt, funcs, func(cu *sym.CompilationUnit, i goobj.CUFileIndex) {
+		name := tinyFilename(cu.FileTable[i])
+		if _, ok := state.tinyFileIndices[name]; !ok {
+			state.tinyFileIndices[name] = int32(len(files))
+			files = append(files, name)
+			offsets = append(offsets, uint32(size))
+			size += int64(len(name) + 1)
+		}
+	})
+	state.cutab = state.addGeneratedSym(ctxt, "runtime.cutab", int64(len(files)*4), 4, func(ctxt *Link, s loader.Sym) {
+		sb := ctxt.loader.MakeSymbolUpdater(s)
+		for i, offset := range offsets {
+			sb.SetUint32(ctxt.Arch, int64(i*4), offset)
+		}
+	})
+	state.filetab = state.addGeneratedSym(ctxt, "runtime.filetab", size, 1, func(ctxt *Link, s loader.Sym) {
+		sb := ctxt.loader.MakeSymbolUpdater(s)
+		for i, name := range files {
+			sb.AddCStringAt(int64(offsets[i]), name)
+		}
+	})
+	state.nfiles = uint32(len(files))
+	// All functions use the same dense table, with no dead per-CU holes.
+	return make([]uint32, len(compUnits))
+}
+
+// rewriteTinyPCFile rewrites CU-local indices without mutating shared pcdata symbols.
+// Tables with no opaque sites are omitted, and adjacent hidden ranges coalesce.
+func (state *pclntab) rewriteTinyPCFile(ctxt *Link, s, pcfile loader.Sym) []byte {
+	ldr := ctxt.loader
+	cu := ldr.SymUnit(s)
+	if cu == nil || len(ldr.Data(pcfile)) == 0 {
+		return nil
+	}
+	var out []byte
+	previous, value := int32(-1), int32(-1)
+	var start, end uint32
+	hasSite := false
+	flush := func() {
+		out = binary.AppendVarint(out, int64(value)-int64(previous))
+		out = binary.AppendUvarint(out, uint64(end-start))
+		previous = value
+		start = end
+	}
+	it := obj.NewPCIter(1)
+	for it.Init(ldr.Data(pcfile)); !it.Done; it.Next() {
+		next := int32(-1)
+		if it.Value >= 0 {
+			name := tinyFilename(cu.FileTable[it.Value])
+			if name != "?" {
+				next = state.tinyFileIndices[name]
+				hasSite = true
+			}
+		}
+		if it.PC != 0 && next != value {
+			flush()
+		}
+		value = next
+		end = it.NextPC
+	}
+	if !hasSite {
+		return nil
+	}
+	flush()
+	return append(out, 0)
+}
