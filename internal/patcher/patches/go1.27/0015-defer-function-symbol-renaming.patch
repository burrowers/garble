From c20341f9f0675d011d9dd97f60a22dc26ab8bdcc Mon Sep 17 00:00:00 2001
From: Paul Scheduikat <luantak@pm.me>
Date: Wed, 25 Nov 2026 13:31:42 +0000
Subject: [PATCH] compile: defer garble function renaming to emission

An intrinsic can retain its declaration name in the compiler without
using that spelling in the object file. Read the optional emission
entries separately from the semantic lookups. Use them in PkgLinksym
without changing the symbol's package ownership or ABI.

Refs burrowers/garble#1422
---
 cmd/compile/internal/base/link.go |  7 ++++++-
 cmd/internal/objabi/garble.go     | 22 ++++++++++++++++++----
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/cmd/compile/internal/base/link.go b/cmd/compile/internal/base/link.go
index d8aa5a7d..851317da 100644
--- a/cmd/compile/internal/base/link.go
+++ b/cmd/compile/internal/base/link.go
@@ -6,6 +6,7 @@ package base
 
 import (
 	"cmd/internal/obj"
+	"cmd/internal/objabi"
 )
 
 // ReservedImports are import paths used internally for generated
@@ -37,7 +38,11 @@ func PkgLinksym(prefix, name string, abi obj.ABI) *obj.LSym {
 	if ReservedImports[prefix] {
 		sep = ":"
 	}
-	return linksym(prefix, prefix+sep+name, abi)
+	linkName := prefix + sep + name
+	if emitted := objabi.EmittedSymbol(linkName); emitted != "" {
+		linkName = emitted
+	}
+	return linksym(prefix, linkName, abi)
 }
 
 // Linkname returns the linker symbol for the given name as it might
diff --git a/cmd/internal/objabi/garble.go b/cmd/internal/objabi/garble.go
index 40faa2fb..89ef4f83 100644
--- a/cmd/internal/objabi/garble.go
+++ b/cmd/internal/objabi/garble.go
@@ -23,6 +23,7 @@ const (
 type nameMap struct {
 	forward map[string]string
 	reverse map[string]string
+	emitted map[string]string
 }
 
 func parseNameMap(value string) nameMap {
@@ -31,12 +32,19 @@ func parseNameMap(value string) nameMap {
 		reverse: make(map[string]string),
 	}
 	for _, entry := range strings.Split(value, ",") {
-		obfuscated, original, ok := strings.Cut(entry, "=")
-		if !ok || obfuscated == "" || original == "" {
+		key, value, ok := strings.Cut(entry, "=")
+		if !ok || key == "" || value == "" {
 			continue
 		}
-		m.forward[obfuscated] = original
-		m.reverse[original] = obfuscated
+		if compilerName, ok := strings.CutPrefix(key, "@"); ok {
+			if m.emitted == nil {
+				m.emitted = make(map[string]string)
+			}
+			m.emitted[compilerName] = value
+			continue
+		}
+		m.forward[key] = value
+		m.reverse[value] = key
 	}
 	return m
 }
@@ -63,6 +71,12 @@ var symbols = sync.OnceValue(func() nameMap {
 	return parseNameMap(readNameMap(symbolMapEnv))
 })
 
+// EmittedSymbol returns the linker spelling of a compiler-named symbol, or
+// the empty string if Garble has not deferred this symbol's renaming.
+func EmittedSymbol(compilerName string) string {
+	return symbols().emitted[compilerName]
+}
+
 // OriginalPackagePath returns the original package path for an obfuscated path.
 func OriginalPackagePath(path string) string {
 	if original := pkgPaths().forward[path]; original != "" {
-- 
