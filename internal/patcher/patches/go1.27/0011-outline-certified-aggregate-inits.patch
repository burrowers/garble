From 460316d1f6a464d4361c7ec9bf9dc70e0152c6e7 Mon Sep 17 00:00:00 2001
From: Paul Scheduikat <luantak@pm.me>
Date: Sun, 11 Oct 2026 21:02:53 +0000
Subject: [PATCH] compile: admit certified constant aggregate inits

Allow the existing literal-init certificate contract to cover arrays and structs as well as strings. Require the factory result to have exactly the global type; keep direct-call validation and all linkname and dynamic-linking exclusions.

Refs burrowers/garble#1170
---
 cmd/compile/internal/staticinit/sched.go | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/cmd/compile/internal/staticinit/sched.go b/cmd/compile/internal/staticinit/sched.go
index 3a494d7f..2a9f01b7 100644
--- a/cmd/compile/internal/staticinit/sched.go
+++ b/cmd/compile/internal/staticinit/sched.go
@@ -1117,7 +1117,7 @@ func init() {
 }
 
 // Garble supplies this manifest only for factories it generated from a single
-// constant string initializer. User names and pragmas alone cannot authorize
+// constant string or aggregate initializer. User names and pragmas alone cannot authorize
 // removing a call. Keep this separate from the general side-effect analysis.
 func certifiedLiteralInit(as *ir.AssignStmt, nm *ir.Name) bool {
 	// -shared requests PIC, also used by ordinary Darwin arm64 executables.
@@ -1135,11 +1135,11 @@ func certifiedLiteralInit(as *ir.AssignStmt, nm *ir.Name) bool {
 		return false
 	}
 	call, ok := as.Y.(*ir.CallExpr)
-	if !ok || call.Op() != ir.OCALLFUNC || len(call.Args) != 0 || len(call.Init()) != 0 || len(as.Init()) != 0 || nm.Class != ir.PEXTERN || nm.Sym().Pkg != types.LocalPkg || !nm.Type().IsString() {
+	if !ok || call.Op() != ir.OCALLFUNC || len(call.Args) != 0 || len(call.Init()) != 0 || len(as.Init()) != 0 || nm.Class != ir.PEXTERN || nm.Sym().Pkg != types.LocalPkg || !(nm.Type().IsString() || nm.Type().IsArray() || nm.Type().IsStruct()) {
 		base.Fatalf("invalid certified literal initializer for %v", nm)
 	}
 	callee, ok := call.Fun.(*ir.Name)
-	if !ok || callee.Class != ir.PFUNC || callee.Sym().Pkg != types.LocalPkg || callee.Sym().Name != factory || callee.Func == nil || callee.Type().NumParams() != 0 || callee.Type().NumResults() != 1 || !call.Type().IsString() {
+	if !ok || callee.Class != ir.PFUNC || callee.Sym().Pkg != types.LocalPkg || callee.Sym().Name != factory || callee.Func == nil || callee.Type().NumParams() != 0 || callee.Type().NumResults() != 1 || !types.Identical(call.Type(), nm.Type()) {
 		base.Fatalf("invalid certified literal factory for %v", nm)
 	}
 	return true
-- 
2.47.3

