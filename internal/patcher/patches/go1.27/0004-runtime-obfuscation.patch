+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package base
+
+import (
+	"os"
+	"strings"
+)
+
+var garblePkgPathMap map[string]string
+var garblePkgPathReverseMap map[string]string
+var garbleSymbolReverseMap map[string]string
+
+func init() {
+	garblePkgPathMap = make(map[string]string)
+	garblePkgPathReverseMap = make(map[string]string)
+	if mapStr := os.Getenv("GARBLE_PKGPATH_MAP"); mapStr != "" {
+		for _, entry := range strings.Split(mapStr, ",") {
+			parts := strings.SplitN(entry, "=", 2)
+			if len(parts) == 2 {
+				garblePkgPathMap[parts[0]] = parts[1]
+				garblePkgPathReverseMap[parts[1]] = parts[0]
+			}
+		}
+	}
+	garbleSymbolReverseMap = make(map[string]string)
+	if mapStr := os.Getenv("GARBLE_SYMBOL_MAP"); mapStr != "" {
+		for _, entry := range strings.Split(mapStr, ",") {
+			parts := strings.SplitN(entry, "=", 2)
+			if len(parts) == 2 {
+				garbleSymbolReverseMap[parts[1]] = parts[0]
+			}
+		}
+	}
+}
+
+// TranslateGarblePkgPath returns the original package path for an obfuscated path.
+func TranslateGarblePkgPath(pkgPath string) string {
+	if original, ok := garblePkgPathMap[pkgPath]; ok {
+		return original
+	}
+	return pkgPath
+}
+
+// IsGarblePkgPath reports whether pkgPath was explicitly mapped from an
+// obfuscated package path.
+func IsGarblePkgPath(pkgPath string) bool {
+	_, ok := garblePkgPathMap[pkgPath]
+	return ok
+}
+
+// GarbleRuntimeSymbol returns the package path and declaration name used by
+// garbled object files for an original toolchain-generated runtime reference.
+func GarbleRuntimeSymbol(pkgPath, name string) (string, string) {
+	if obfuscated, ok := garbleSymbolReverseMap[pkgPath+"."+name]; ok {
+		if i := strings.LastIndexByte(obfuscated, '.'); i >= 0 {
+			return obfuscated[:i], obfuscated[i+1:]
+		}
+	}
+	if obfuscated, ok := garblePkgPathReverseMap[pkgPath]; ok {
+		pkgPath = obfuscated
+	}
+	return pkgPath, name
+}
