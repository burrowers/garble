+	"internal/abi"
+	"testing"
+)
+
+func TestGetFuncIDGarbleSymbol(t *testing.T) {
+	t.Setenv("GARBLE_SYMBOL_MAP", "obfruntime.obfgopanic=runtime.gopanic")
+	t.Setenv("GARBLE_PKGPATH_MAP", "obfruntime=runtime")
+	if got := GetFuncID("obfruntime.obfgopanic", false); got != abi.FuncID_gopanic {
+		t.Fatalf("GetFuncID(obfuscated gopanic) = %v, want %v", got, abi.FuncID_gopanic)
+	}
+	if got := OriginalFuncName("obfruntime.obfgopanic"); got != "runtime.gopanic" {
+		t.Fatalf("OriginalFuncName(obfuscated gopanic) = %q, want runtime.gopanic", got)
+	}
+	if got := OriginalFuncName("obfruntime.obfgoexit"); got != "runtime.obfgoexit" {
+		t.Fatalf("OriginalFuncName(runtime package member) = %q, want runtime.obfgoexit", got)
+	}
+}
diff --git a/cmd/internal/objabi/garble.go b/cmd/internal/objabi/garble.go
new file mode 100644
index 0000000000..fcb6d45dfb
--- /dev/null
+++ b/cmd/internal/objabi/garble.go
@@ -0,0 +1,129 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Garble name mappings are shared by the compiler, assembler, and linker.
+package objabi
+
+import (
+	"os"
+	"strings"
+	"sync"
+)
+
+const (
+	pkgPathMapEnv = "GARBLE_PKGPATH_MAP"
+	symbolMapEnv  = "GARBLE_SYMBOL_MAP"
+)
+
+type nameMap struct {
+	forward map[string]string
+	reverse map[string]string
+}
+
+func parseNameMap(value string) nameMap {
+	m := nameMap{
+		forward: make(map[string]string),
+		reverse: make(map[string]string),
+	}
+	for _, entry := range strings.Split(value, ",") {
+		obfuscated, original, ok := strings.Cut(entry, "=")
+		if !ok || obfuscated == "" || original == "" {
+			continue
+		}
+		m.forward[obfuscated] = original
+		m.reverse[original] = obfuscated
+	}
+	return m
+}
+
+var pkgPaths = sync.OnceValue(func() nameMap {
+	return parseNameMap(os.Getenv(pkgPathMapEnv))
+})
+
+var symbols = sync.OnceValue(func() nameMap {
+	return parseNameMap(os.Getenv(symbolMapEnv))
+})
+
+// OriginalPackagePath returns the original package path for an obfuscated path.
+func OriginalPackagePath(path string) string {
+	if original := pkgPaths().forward[path]; original != "" {
+		return original
+	}
+	return path
+}
+
+// IsPackagePathMapped reports whether path is an obfuscated package path.
+func IsPackagePathMapped(path string) bool {
+	_, ok := pkgPaths().forward[path]
+	return ok
+}
+
+// ObfuscatedPackagePath returns the obfuscated package path for an original
+// path, or path when no mapping exists.
+func ObfuscatedPackagePath(path string) string {
+	if obfuscated := pkgPaths().reverse[path]; obfuscated != "" {
+		return obfuscated
+	}
+	return path
+}
+
+// OriginalSymbol returns the original symbol for an obfuscated symbol.
+func OriginalSymbol(name string) string {
+	if original := symbols().forward[name]; original != "" {
+		return original
+	}
+	return name
+}
+
+// OriginalSymbolParts translates an explicitly mapped package path and
+// declaration name. It does not apply the package-path fallback.
+func OriginalSymbolParts(path, name string) (string, string) {
+	original := OriginalSymbol(path + "." + name)
+	if original == path+"."+name {
+		return path, name
+	}
+	if dot := strings.LastIndexByte(original, '.'); dot >= 0 {
+		return original[:dot], original[dot+1:]
+	}
+	return path, name
+}
+
+// OriginalPackageSymbol translates an obfuscated package path and declaration
+// name to their original values.
+func OriginalPackageSymbol(path, name string) (string, string) {
+	originalPath, originalName := OriginalSymbolParts(path, name)
+	if originalPath != path || originalName != name {
+		return originalPath, originalName
+	}
+	return OriginalPackagePath(path), name
+}
+
+// ObfuscatedSymbol returns the obfuscated symbol for an original symbol, or an
+// empty string when no mapping exists.
+func ObfuscatedSymbol(name string) string {
+	if obfuscated := symbols().reverse[name]; obfuscated != "" {
+		return obfuscated
+	}
+	for original, obfuscated := range pkgPaths().reverse {
+		if strings.HasPrefix(name, original+".") {
+			return obfuscated + name[len(original):]
+		}
+	}
+	return ""
+}
+
+// OriginalFuncName returns the original fully qualified function name. The
+// symbol map takes precedence because it can rename both the package and the
+// declaration. The package map handles names absent from the symbol map.
+func OriginalFuncName(name string) string {
+	if original := symbols().forward[name]; original != "" {
+		return original
+	}
+	for obfuscated, original := range pkgPaths().forward {
+		if strings.HasPrefix(name, obfuscated+".") {
+			return original + name[len(obfuscated):]
+		}
+	}
+	return name
+}
diff --git a/cmd/internal/objabi/garble_test.go b/cmd/internal/objabi/garble_test.go
new file mode 100644
index 0000000000..1330938940
--- /dev/null
+++ b/cmd/internal/objabi/garble_test.go
@@ -0,0 +1,52 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package objabi
+
+import "testing"
+
+func TestParseNameMap(t *testing.T) {
+	got := parseNameMap("obf=original,invalid,=empty,empty=,obf2=original2")
+	if got.forward["obf"] != "original" || got.forward["obf2"] != "original2" {
+		t.Fatalf("forward map = %v", got.forward)
+	}
+	if got.reverse["original"] != "obf" || got.reverse["original2"] != "obf2" {
+		t.Fatalf("reverse map = %v", got.reverse)
+	}
+	if len(got.forward) != 2 || len(got.reverse) != 2 {
+		t.Fatalf("unexpected entries: forward=%v reverse=%v", got.forward, got.reverse)
+	}
+}
+
+func TestNameTranslations(t *testing.T) {
+	oldPkgPaths, oldSymbols := pkgPaths, symbols
+	pkgPaths = func() nameMap {
+		return parseNameMap("obf.example/runtime=example.com/runtime,obfruntime=runtime")
+	}
+	symbols = func() nameMap {
+		return parseNameMap("obfruntime.obfpanic=runtime.gopanic")
+	}
+	t.Cleanup(func() {
+		pkgPaths, symbols = oldPkgPaths, oldSymbols
+	})
+
+	if got := OriginalPackagePath("obf.example/runtime"); got != "example.com/runtime" {
+		t.Fatalf("OriginalPackagePath = %q", got)
+	}
+	if got := ObfuscatedPackagePath("example.com/runtime"); got != "obf.example/runtime" {
+		t.Fatalf("ObfuscatedPackagePath = %q", got)
+	}
+	if path, name := OriginalPackageSymbol("obfruntime", "obfpanic"); path != "runtime" || name != "gopanic" {
+		t.Fatalf("OriginalPackageSymbol = %q, %q", path, name)
+	}
+	if got := ObfuscatedSymbol("runtime.gopanic"); got != "obfruntime.obfpanic" {
+		t.Fatalf("ObfuscatedSymbol exact = %q", got)
+	}
+	if got := ObfuscatedSymbol("example.com/runtime..inittask"); got != "obf.example/runtime..inittask" {
+		t.Fatalf("ObfuscatedSymbol package fallback = %q", got)
+	}
+	if got := OriginalFuncName("obf.example/runtime.someFunc"); got != "example.com/runtime.someFunc" {
+		t.Fatalf("OriginalFuncName = %q", got)
+	}
+}
